msgid "Vorspann automatisch überspringen:"
msgstr "Skip the intro automatically:"
msgid "Überspringt den Vorspann ohne Nachfrage. Bei 'Nein' erscheint jedes Mal die Frage."
msgstr "Skips the intro without asking. No shows the question every time."
msgid "Genre wechseln: In der obersten Reihe HOCH drücken | Film %s / %s | OK = Abspielen | RUNTER = Buchstabe"
msgstr "Change genre: Press UP on the top row | Movie %s / %s | OK = Play | DOWN = Letter"
msgid "Genre wechseln: In der obersten Reihe HOCH drücken | Keine Filme vorhanden | RUNTER = Buchstabe"
msgstr "Change genre: Press UP on the top row | No movies available | DOWN = Letter"
msgid "Genre wechseln: In der obersten Reihe HOCH drücken | Serie %s / %s | OK = Staffeln anzeigen | RUNTER = Buchstabe"
msgstr "Change genre: Press UP on the top row | Show %s / %s | OK = Show seasons | DOWN = Letter"
msgid "Genre wechseln: In der obersten Reihe HOCH drücken | Keine Serien in dieser Kategorie | RUNTER = Buchstabe"
msgstr "Change genre: Press UP on the top row | No shows in this category | DOWN = Letter"
msgid "Keine Sammlungen in dieser Kategorie. | RUNTER = Buchstabe"
msgstr "No collections in this category. | DOWN = Letter"
msgid "Genre wechseln: In der obersten Reihe HOCH drücken | Sammlung %s / %s | OK = Öffnen | RUNTER = Buchstabe"
msgstr "Change genre: Press UP on the top row | Collection %s / %s | OK = Open | DOWN = Letter"
msgid "Genre wechseln: In der obersten Reihe HOCH drücken | Album %s / %s | OK = Album öffnen | RUNTER = Buchstabe"
msgstr "Change genre: press UP in the top row | Album %s / %s | OK = Open album | DOWN = Letter"
msgid "Genre wechseln: In der obersten Reihe HOCH drücken | Keine Alben vorhanden | RUNTER = Buchstabe"
msgstr "Change genre: press UP in the top row | No albums | DOWN = Letter"
msgid "Filter zurücksetzen"
msgstr "Reset filter"
msgid "LINKS/RECHTS = Buchstabe | OK = filtern | HOCH = zurück"
msgstr "LEFT/RIGHT = Letter | OK = Filter | UP = Back"
msgid "Nichts hier.\nEs sind aktuell keine Einträge verfügbar."
msgstr "Nothing here.\nThere are currently no items available."
